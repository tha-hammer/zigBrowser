(version 1)
;; ======================================================================================================
;; MS6.1 — TOKEN ISOLATION (plan §MS6.1). A sandboxed hook must NOT read the CLI's token by introspecting
;; the CLI process. This profile adds the token-isolation capability on top of the containment spike:
;;   - process-info and task-port rights are NOT granted (so (deny default) blocks task_for_pid / proc_pidinfo);
;;   - sysctl-read is curated: kern.procargs2 / kern.procargs (a same-user process's argv+env — how `ps`
;;     reads another process, the deterministic leak) are DENIED, while general sysctl-read still works so
;;     the probe runs.
;; The rest matches the spike's WRITE/NETWORK/CHILD containment. Reads stay broad here (deny-default read
;; curation is a separate later MS6 increment); that does not affect token isolation, which is about the
;; CLI *process*, not files.
;; Params via -D: SCRATCHPAD (writable), PROTECTED (read-denied).
;; ======================================================================================================
(deny default)

(allow process-fork)
(allow process-exec)

;; Broad reads (as the spike) so the probe + its dylibs load; PROTECTED is read-denied (read containment).
(allow file-read*)
(deny file-read* (subpath (param "PROTECTED")))

;; Writes: ONLY the SCRATCHPAD + the standard character devices (as the spike).
(allow file-write*
  (subpath (param "SCRATCHPAD"))
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/dtracehelper") (literal "/dev/tty"))

;; Network: deny-default; only the two loopback bridge ports (as the spike).
(allow network-outbound (remote ip "localhost:51091") (remote ip "localhost:31337"))

;; sysctl-read CURATED (MS6.1): a small allowlist so the process runs, NOT a blanket (allow sysctl-read).
;; Measured on both arches: a blanket allow re-opens another process's kern.procargs2 (argv+env) EVEN with
;; process-info denied, so the CLI's token on its command line / env would leak. KERN_PROCARGS2 is a numeric
;; MIB with no string name, so it cannot be denied by (sysctl-name ...); it is instead kept out by (a) not
;; allowing sysctl-read broadly and (b) the explicit process-info deny below. Both are needed (mutant: remove
;; either and the hook reads the canary).
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name-prefix "kern.os")
  (sysctl-name "kern.ostype") (sysctl-name "kern.osrelease") (sysctl-name "kern.version")
  (sysctl-name "kern.hostname") (sysctl-name "kern.maxproc") (sysctl-name "kern.argmax"))

;; process-info / task-port: EXPLICITLY denied. Measured: (deny default) alone does NOT block cross-process
;; proc_pidinfo/proc_pidpath or (with any sysctl-read) kern.procargs2 — only an explicit (deny process-info*)
;; does. No (allow mach-priv-task-port) either (task_for_pid is also system-denied, but we never grant it).
(deny process-info*)

(allow mach-lookup)   ;; as the spike — the tiny curated mach-lookup is a separate later MS6 increment.
