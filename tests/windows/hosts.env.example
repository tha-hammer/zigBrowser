# Copy to tests/windows/hosts.env and fill in, then `set -a; . tests/windows/hosts.env; set +a`.
# Never commit a real hosts.env. The gate reads these; the user (not an agent) edits them.
#
# The gate sets ZB_GUEST_USER per host from ZB_WIN11_USER / ZB_WIN10_USER before probing/staging
# that host, so the two hosts can use different accounts (the VM uses zbtext, the file server zbtest).

# --- Win11 VM (build + run), reached via the local libvirt passt forward (127.0.0.1:2222) ---
ZB_WIN11_HOST=127.0.0.1
ZB_WIN11_PORT=2222
ZB_WIN11_DOMAIN=win11-m8
ZB_WIN11_USER=zbtext
ZB_WIN_KEY=/home/maceo/vms/win11-m8/zb_win_key
# Pinned host key (WS0.8). Point at the VM's known_hosts or paste the key into tests/windows/known_hosts.
ZB_WIN_KNOWN_HOSTS=/home/maceo/vms/win11-m8/known_hosts

# --- Windows 10 file server (run only), tailnet. Enable OpenSSH there first; keep tests fenced. ---
#ZB_WIN10_HOST=100.123.34.15
#ZB_WIN10_PORT=22
#ZB_WIN10_USER=zbtest
