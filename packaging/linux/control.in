Package: zigbrowser
Version: @VERSION@
Section: web
Priority: optional
Architecture: amd64
Depends: libwebkit2gtk-4.1-0, libgtk-3-0, python3 (>= @PY_MINOR@), python3 (<< @PY_NEXT@), bubblewrap, procps, ca-certificates
